{
  "name": "rosio",
  "displayName": "rosio: ROS 2 system atlas",
  "description": "What your ROS 2 system really is, written, coded, running and recorded, where those disagree and which line to edit.",
  "version": "0.2.0",
  "publisher": "sa1ntsinner",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#111111",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sa1ntsinner/rosio"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ros",
    "ros2",
    "robotics",
    "launch",
    "urdf",
    "zenoh",
    "rosbag"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:rosio.yaml",
    "workspaceContains:rosio-out/atlas.json",
    "workspaceContains:**/package.xml",
    "onView:rosio.system"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In restricted mode the commands from workspace settings are ignored.",
      "restrictedConfigurations": [
        "rosio.command",
        "rosio.server.path"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rosio",
          "title": "rosio",
          "icon": "media/rosio.svg"
        }
      ]
    },
    "views": {
      "rosio": [
        {
          "id": "rosio.findings",
          "name": "Findings"
        },
        {
          "id": "rosio.launch",
          "name": "Launch"
        },
        {
          "id": "rosio.frames",
          "name": "Frames",
          "visibility": "collapsed"
        },
        {
          "id": "rosio.params",
          "name": "Parameters",
          "visibility": "collapsed"
        },
        {
          "id": "rosio.system",
          "name": "System",
          "visibility": "collapsed"
        },
        {
          "id": "rosio.unresolved",
          "name": "Unresolved",
          "visibility": "collapsed"
        },
        {
          "id": "rosio.migration",
          "name": "Migration",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rosio.findings",
        "contents": "No atlas in this workspace yet.\n[Extract the atlas](command:rosio.extract)"
      },
      {
        "view": "rosio.unresolved",
        "contents": "Every name and value in the atlas was resolved."
      },
      {
        "view": "rosio.launch",
        "contents": "Launch files and the nodes they start appear here once the atlas is extracted."
      },
      {
        "view": "rosio.frames",
        "contents": "Robot model links and the frames the code uses appear here once the atlas is extracted."
      },
      {
        "view": "rosio.system",
        "contents": "Nodes, topics, parameters and frames appear here once the atlas is extracted."
      },
      {
        "view": "rosio.migration",
        "contents": "See what moving this workspace to another ROS 2 release changes, line by line.\n[Plan migration](command:rosio.planMigration)"
      },
      {
        "view": "rosio.params",
        "contents": "Every parameter with the value that wins appears here once the atlas is extracted."
      }
    ],
    "commands": [
      {
        "command": "rosio.showGraph",
        "title": "Show the system graph",
        "category": "rosio",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "rosio.showRobot",
        "title": "Show the robot model",
        "category": "rosio",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "rosio.openAtlas",
        "title": "Open the atlas",
        "category": "rosio",
        "icon": "$(graph)"
      },
      {
        "command": "rosio.extract",
        "title": "Extract the atlas",
        "category": "rosio",
        "icon": "$(refresh)"
      },
      {
        "command": "rosio.find",
        "title": "Find a node, topic, parameter or frame",
        "category": "rosio",
        "icon": "$(search)"
      },
      {
        "command": "rosio.showEntity",
        "title": "Show in the atlas",
        "category": "rosio"
      },
      {
        "command": "rosio.checkStamps",
        "title": "Check the header stamps of a recording",
        "category": "rosio"
      },
      {
        "command": "rosio.restartServer",
        "title": "Restart the language server",
        "category": "rosio"
      },
      {
        "command": "rosio.planMigration",
        "title": "Plan migration to another ROS 2 release",
        "shortTitle": "Plan migration",
        "category": "rosio",
        "icon": "$(versions)"
      },
      {
        "command": "rosio.applyMigration",
        "title": "Apply the exact rewrites",
        "category": "rosio",
        "icon": "$(replace-all)"
      },
      {
        "command": "rosio.verifyMigration",
        "title": "Build the workspace in the target release",
        "shortTitle": "Verify build",
        "category": "rosio",
        "icon": "$(beaker)"
      },
      {
        "command": "rosio.clearMigration",
        "title": "Clear the migration plan",
        "category": "rosio",
        "icon": "$(clear-all)"
      },
      {
        "command": "rosio.findParameter",
        "title": "Find parameter",
        "category": "rosio",
        "icon": "$(search)"
      },
      {
        "command": "rosio.fixFinding",
        "title": "Apply fix",
        "category": "rosio",
        "icon": "$(lightbulb-autofix)"
      },
      {
        "command": "rosio.fixAll",
        "title": "Apply every exact fix",
        "shortTitle": "Apply fixes",
        "category": "rosio",
        "icon": "$(wand)"
      },
      {
        "command": "rosio.copyFinding",
        "title": "Copy finding",
        "category": "rosio"
      },
      {
        "command": "rosio.copyFindings",
        "title": "Copy all findings",
        "category": "rosio"
      },
      {
        "command": "rosio.probe",
        "title": "Probe the running system",
        "category": "rosio"
      }
    ],
    "keybindings": [
      {
        "command": "rosio.find",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "rosio.openAtlas",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r"
      },
      {
        "command": "rosio.fixAll",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "rosio.fixable"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rosio.showRobot",
          "when": "view == rosio.frames",
          "group": "navigation@0"
        },
        {
          "command": "rosio.showGraph",
          "when": "view == rosio.launch || view == rosio.system",
          "group": "navigation@0"
        },
        {
          "command": "rosio.findParameter",
          "when": "view == rosio.params",
          "group": "navigation@1"
        },
        {
          "command": "rosio.find",
          "when": "view == rosio.system",
          "group": "navigation@1"
        },
        {
          "command": "rosio.extract",
          "when": "view == rosio.findings",
          "group": "navigation@1"
        },
        {
          "command": "rosio.openAtlas",
          "when": "view == rosio.findings",
          "group": "navigation@2"
        },
        {
          "command": "rosio.planMigration",
          "when": "view == rosio.migration",
          "group": "navigation"
        },
        {
          "command": "rosio.applyMigration",
          "when": "view == rosio.migration && rosio.migrationRewrites",
          "group": "navigation"
        },
        {
          "command": "rosio.verifyMigration",
          "when": "view == rosio.migration && rosio.migrationPlanned",
          "group": "navigation@5"
        },
        {
          "command": "rosio.clearMigration",
          "when": "view == rosio.migration && rosio.migrationPlanned",
          "group": "navigation@9"
        },
        {
          "command": "rosio.fixAll",
          "when": "view == rosio.findings && rosio.fixable",
          "group": "navigation@0"
        },
        {
          "command": "rosio.copyFindings",
          "when": "view == rosio.findings",
          "group": "copy"
        }
      ],
      "view/item/context": [
        {
          "command": "rosio.showRobot",
          "when": "viewItem == rosio.inModel",
          "group": "navigation"
        },
        {
          "command": "rosio.showGraph",
          "when": "viewItem == rosio.graphable",
          "group": "navigation"
        },
        {
          "command": "rosio.applyMigration",
          "when": "view == rosio.migration && viewItem == migration.automatic",
          "group": "inline"
        },
        {
          "command": "rosio.fixFinding",
          "when": "view == rosio.findings && viewItem == finding.fixable",
          "group": "inline"
        },
        {
          "command": "rosio.copyFinding",
          "when": "view == rosio.findings && viewItem =~ /^finding/",
          "group": "copy"
        }
      ],
      "explorer/context": [
        {
          "command": "rosio.checkStamps",
          "when": "resourceFilename == metadata.yaml || resourceExtname == .mcap || resourceExtname == .db3 || resourceExtname == .bag",
          "group": "rosio"
        }
      ],
      "commandPalette": [
        {
          "command": "rosio.showEntity",
          "when": "false"
        },
        {
          "command": "rosio.fixFinding",
          "when": "false"
        },
        {
          "command": "rosio.copyFinding",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "rosio",
      "properties": {
        "rosio.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "rosio"
          ],
          "markdownDescription": "The `rosio` command, as an argument list, for example `[\"python3\", \"-m\", \"rosio\"]`. It needs the ROS environment of the workspace, so start the editor from a shell that sourced it, or point this at a wrapper script."
        },
        "rosio.extractArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "extract",
            "."
          ],
          "markdownDescription": "Arguments for extraction. With a `rosio.yaml` in the workspace use `[\"extract\", \"--config\", \"rosio.yaml\"]`."
        },
        "rosio.extractOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Extract again when a file the atlas cites is saved."
        },
        "rosio.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show endpoint peers and QoS incompatibilities above source lines. Restart the language server after changing this setting."
        },
        "rosio.atlasPath": {
          "type": "string",
          "default": "rosio-out/atlas.json",
          "description": "Where the atlas is, relative to the workspace folder."
        },
        "rosio.server.path": {
          "type": "string",
          "default": "",
          "description": "The rosio language server executable."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "build": "tsc -p . --noEmit && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "tsc -p . --noEmit && node scripts/build.mjs --minify && vsce package --no-dependencies -o rosio.vsix",
    "test:e2e": "node scripts/build.mjs && node test-e2e/run.mjs",
    "test": "node --test test-unit/*.test.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.12",
    "mocha": "^11.8.0",
    "typescript": "~5.9.2"
  }
}
