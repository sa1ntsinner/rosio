<?xml version="1.0"?>
<robot name="rover">
  <material name="body">
    <color rgba="0.82 0.84 0.86 1"/>
  </material>
  <material name="rubber">
    <color rgba="0.2 0.2 0.22 1"/>
  </material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.50 0.34 0.12"/></geometry>
      <material name="body"/>
    </visual>
    <visual name="wheel_left">
      <origin xyz="0 0.21 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.06"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual name="wheel_right">
      <origin xyz="0 -0.21 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.06"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.50 0.46 0.20"/></geometry>
    </collision>
  </link>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="rubber"/>
    </visual>
  </link>

  <link name="imu_link">
    <visual>
      <geometry><box size="0.04 0.04 0.01"/></geometry>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.22 0 0.18" rpy="0 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
</robot>
