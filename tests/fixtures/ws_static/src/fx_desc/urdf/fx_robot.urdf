<?xml version="1.0"?>
<!--
  Real robot variant. Three variants share the robot name on purpose, so a
  resolver that keys on the robot name merges three different models.
  Frames only this variant declares: tow_link, imu_mount.
-->
<robot name="fx_robot">

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0.25 0 0.1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fx_desc/meshes/fx_body.stl" scale="1 1 1"/>
      </geometry>
      <material name="fx_black"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.25 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.6 0.45 0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="35.0"/>
      <origin xyz="0.25 0 0.1" rpy="0 0 0"/>
      <inertia ixx="0.8" ixy="0" ixz="0" iyy="1.2" iyz="0" izz="1.5"/>
    </inertial>
  </link>

  <joint name="drive_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="drive_left_wheel"/>
    <origin xyz="0.05 0.21 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="drive_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.11" length="0.04"/></geometry>
    </visual>
  </link>

  <joint name="drive_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="drive_right_wheel"/>
    <origin xyz="0.05 -0.21 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="drive_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.11" length="0.04"/></geometry>
    </visual>
  </link>

  <joint name="caster_swivel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="caster_swivel_link"/>
    <origin xyz="0.45 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="0.7854" effort="40" velocity="2.0"/>
  </joint>

  <link name="caster_swivel_link"/>

  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_swivel_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </visual>
  </link>

  <!-- Mimic joint: the dashboard indicator follows the real steering axis. -->
  <joint name="steer_indicator_joint" type="revolute">
    <parent link="caster_swivel_link"/>
    <child link="steer_indicator"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="0.7854" effort="1" velocity="1"/>
    <mimic joint="caster_swivel_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="steer_indicator"/>

  <joint name="sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_link"/>
    <origin xyz="0.4 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="sensor_link">
    <visual name="sensor_dome">
      <geometry><sphere radius="0.05"/></geometry>
      <material name="fx_orange"/>
    </visual>
  </link>

  <joint name="tow_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tow_link"/>
    <origin xyz="0.05 0 -0.06" rpy="0 0 0"/>
  </joint>

  <link name="tow_link"/>

  <joint name="imu_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_mount"/>
    <origin xyz="0.4 0 0.18" rpy="3.14159 0 0"/>
  </joint>

  <link name="imu_mount"/>

  <material name="fx_orange"><color rgba="0.92 0.4 0 1"/></material>

</robot>
