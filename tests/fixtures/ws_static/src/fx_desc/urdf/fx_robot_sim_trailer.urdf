<?xml version="1.0"?>
<!--
  Trailer sim variant. Same tractor chain, sensor_joint mounted differently,
  imu_link reparented from base_link to sensor_link with an identity origin,
  plus a ray frame and a trailer subtree. The gazebo lidar stamps sensor_ray
  here, not sensor_link.
-->
<robot name="fx_robot">

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0.25 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.6 0.45 0.2"/></geometry>
    </visual>
    <inertial>
      <mass value="35.0"/>
      <origin xyz="0.25 0 0.1" rpy="0 0 0"/>
      <inertia ixx="0.8" ixy="0" ixz="0" iyy="1.2" iyz="0" izz="1.5"/>
    </inertial>
  </link>

  <joint name="drive_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="drive_left_wheel"/>
    <origin xyz="0.05 0.21 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="60" velocity="2.5"/>
  </joint>

  <link name="drive_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.12" length="0.04"/></geometry>
    </visual>
  </link>

  <joint name="drive_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="drive_right_wheel"/>
    <origin xyz="0.05 -0.21 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="60" velocity="2.5"/>
  </joint>

  <link name="drive_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.12" length="0.04"/></geometry>
    </visual>
  </link>

  <joint name="caster_swivel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="caster_swivel_link"/>
    <origin xyz="0.45 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="60" velocity="2.5"/>
  </joint>

  <link name="caster_swivel_link"/>

  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_swivel_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="60" velocity="2.5"/>
  </joint>

  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.12" length="0.03"/></geometry>
    </visual>
  </link>

  <joint name="steer_indicator_joint" type="revolute">
    <parent link="caster_swivel_link"/>
    <child link="steer_indicator"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="1" velocity="1"/>
    <mimic joint="caster_swivel_joint" multiplier="0.5" offset="0.02"/>
  </joint>

  <link name="steer_indicator"/>

  <joint name="sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_link"/>
    <origin xyz="0.38 0 0.31" rpy="1.57 0 1.57"/>
  </joint>

  <link name="sensor_link"/>

  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link"/>

  <joint name="sensor_ray_joint" type="fixed">
    <parent link="sensor_link"/>
    <child link="sensor_ray"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="sensor_ray"/>

  <!-- imu_link hangs off sensor_link here, not base_link, and is coincident. -->
  <joint name="imu_joint" type="fixed">
    <parent link="sensor_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <joint name="trailer_tow_joint" type="revolute">
    <parent link="base_link"/>
    <child link="trailer_link"/>
    <origin xyz="0.05 0 -0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1.0"/>
  </joint>

  <link name="trailer_link">
    <visual>
      <origin xyz="-0.4 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.6 0.4 0.1"/></geometry>
    </visual>
  </link>

  <joint name="trailer_left_joint" type="continuous">
    <parent link="trailer_link"/>
    <child link="trailer_left_wheel"/>
    <origin xyz="-0.6 0.18 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="trailer_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
    </visual>
  </link>

  <joint name="trailer_right_joint" type="continuous">
    <parent link="trailer_link"/>
    <child link="trailer_right_wheel"/>
    <origin xyz="-0.6 -0.18 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="trailer_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
    </visual>
  </link>

  <gazebo>
    <plugin name="fx_tricycle_drive" filename="libfx_tricycle_drive.so">
      <ros>
        <namespace>/fx</namespace>
        <remapping>cmd_vel:=/fx/cmd_vel_sim</remapping>
        <remapping>odom:=/fx/odom_trailer</remapping>
      </ros>
      <update_rate>50</update_rate>
      <steering_joint>caster_swivel_joint</steering_joint>
      <actuated_wheel_joint>caster_wheel_joint</actuated_wheel_joint>
      <wheel_separation>0.42</wheel_separation>
    </plugin>
  </gazebo>

  <gazebo reference="sensor_link">
    <sensor name="fx_lidar" type="ray">
      <update_rate>10</update_rate>
      <plugin name="fx_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/fx</namespace>
          <remapping>~/out:=/fx/points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>sensor_ray</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
